<?xml version="1.0" encoding="utf-8"?>
<!-- 星光影院：左侧栏条目（金色图标 + 名称） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_sidebar_normal">

    <ImageView
        android:id="@+id/sidebar_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:contentDescription="" />

    <TextView
        android:id="@+id/sidebar_item_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textSize="16sp"
        android:textColor="@color/star_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 星光影院：聚焦时右侧金色发光指示条（连接内容区） -->
    <View
        android:id="@+id/sidebar_item_ray"
        android:layout_width="4dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_sidebar_ray"
        android:visibility="gone" />
</LinearLayout>
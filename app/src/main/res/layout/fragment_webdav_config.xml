<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="WebDAV 配置" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="支持任意 WebDAV 服务器，登录后浏览目录播放视频"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="服务器名称"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/serverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/tv_focus_border"
            android:focusable="true"
            android:clickable="true"
            android:imeOptions="actionNext"
            android:nextFocusDown="@+id/serverHost"
            android:hint="例如: 我的 WebDAV" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="主机地址"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/serverHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/tv_focus_border"
            android:focusable="true"
            android:clickable="true"
            android:inputType="textUri"
            android:imeOptions="actionNext"
            android:nextFocusUp="@+id/serverName"
            android:nextFocusDown="@+id/serverPort"
            android:hint="192.168.1.100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="端口"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/serverPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/tv_focus_border"
            android:focusable="true"
            android:clickable="true"
            android:inputType="number"
            android:imeOptions="actionNext"
            android:nextFocusUp="@+id/serverHost"
            android:nextFocusDown="@+id/username"
            android:hint="5005" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="用户名"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/tv_focus_border"
            android:focusable="true"
            android:clickable="true"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:nextFocusUp="@+id/serverPort"
            android:nextFocusDown="@+id/password"
            android:hint="WebDAV 账号（可留空）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="密码"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/tv_focus_border"
            android:focusable="true"
            android:clickable="true"
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            android:nextFocusUp="@+id/username"
            android:nextFocusDown="@+id/basePath"
            android:hint="WebDAV 密码（可留空）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="基础路径"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/basePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="12dp"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:background="@drawable/tv_focus_border"
            android:focusable="true"
            android:clickable="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:nextFocusUp="@+id/password"
            android:nextFocusDown="@+id/testBtn"
            android:hint="/" />

        <TextView
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="测试连接"
            android:textColor="@color/md_theme_primary"
            android:textSize="16sp"
            android:padding="14dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/basePath"
            android:background="@drawable/btn_select_circle" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="保存"
            android:textColor="@color/md_theme_onPrimary"
            android:textSize="16sp"
            android:padding="14dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/testBtn"
            android:background="@drawable/btn_select_circle" />

    </LinearLayout>

</ScrollView>
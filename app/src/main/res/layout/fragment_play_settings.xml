<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放控制"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface"
            android:paddingBottom="12dp" />

        <!-- 默认播放器 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerSelectBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusUp="@id/rememberPosBox"
            android:nextFocusDown="@id/renderConfigBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/playerValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="默认播放器"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="EXO / MPV" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/playerValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="EXO"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 解码/渲染配置 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/renderConfigBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/playerSelectBox"
            android:nextFocusDown="@id/skipIntroBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/renderConfigValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="MPV 解码/渲染配置"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="自动/高端/低端（换配置需重启播放）" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/renderConfigValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="自动"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 跳过片头 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/skipIntroBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/renderConfigBox"
            android:nextFocusDown="@id/cacheBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/skipIntroValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="跳过片头（秒）"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="0=关闭" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/skipIntroValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 缓存大小 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cacheBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/skipIntroBox"
            android:nextFocusDown="@id/seekBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cacheValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="缓存大小（MB）"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="64-2048 MB" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/cacheValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="256"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 快进/快退步长 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/seekBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/cacheBox"
            android:nextFocusDown="@id/subtitleSizeBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/seekValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="快进/快退步长"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="方向键每次跳转秒数" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/seekValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="5秒"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 字幕字体大小 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subtitleSizeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/seekBox"
            android:nextFocusDown="@id/autoNextBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/subtitleSizeValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="字幕大小"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="30-120（720p 参考）" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/subtitleSizeValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="55"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 自动下一集 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/autoNextBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/subtitleSizeBox"
            android:nextFocusDown="@id/rememberPosBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/autoNextSwitch">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="自动下一集"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="播放结束自动跳转下一集" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoNextSwitch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 记住播放进度 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rememberPosBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/autoNextBox"
            android:nextFocusDown="@id/passthroughBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rememberPosSwitch">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="记住播放进度"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="退出后记住播放位置" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/rememberPosSwitch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:nextFocusDown="@id/passthroughBox"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 音频直通（杜比/DTS 源码透传到功放/回音壁） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/passthroughBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/rememberPosBox"
            android:nextFocusDown="@id/playerSelectBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/passthroughSwitch">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="音频直通"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="杜比/DTS 源码透传到功放（MPV 生效，需接 HDMI 回传）"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/passthroughSwitch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:nextFocusDown="@id/playerSelectBox"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</ScrollView>
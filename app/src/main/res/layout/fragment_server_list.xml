<?xml version="1.0" encoding="utf-8"?>
<!-- 星光影院：服务器选择页（左=金渐变添加卡，右=服务器列表） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/star_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- 星光影院：左下角金色光晕 -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-80dp"
            android:layout_marginBottom="-100dp"
            android:background="@drawable/bg_glow_gold" />

        <!-- 左侧：添加服务器（金渐变大卡，占 40% 宽） -->
        <LinearLayout
            android:id="@+id/addServerBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_add_server"
            android:focusable="true"
            android:clickable="true"
            android:elevation="10dp">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:text="+"
                android:textSize="48sp"
                android:textColor="@color/star_gold"
                android:textStyle="bold"
                android:background="@drawable/bg_add_server_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="添加服务器"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/star_bg" />
        </LinearLayout>

        <!-- 右侧：服务器列表（占 60% 宽） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="14dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/star_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的服务器"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/serverList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nextFocusUp="@id/addServerBtn" />
        </LinearLayout>
    </LinearLayout>
<!-- 星光影院：右下角版本号 -->
    <TextView
        android:id="@+id/versionTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:textColor="#66FFFFFF"
        android:textSize="12sp" />
</FrameLayout>
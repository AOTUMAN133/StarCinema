<?xml version="1.0" encoding="utf-8"?>
<!-- 星光影院：服务器编辑/添加页（地址 + 账号 + 密码） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="添加服务器"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/gold_primary"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="服务器地址"
        android:textSize="15sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:hint="http://192.168.1.100:8096"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/search_box_back"
        android:paddingHorizontal="16dp"
        android:inputType="textUri" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="账号"
        android:textSize="15sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/userInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:hint="用户名"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/search_box_back"
        android:paddingHorizontal="16dp"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="密码"
        android:textSize="15sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/passInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:hint="密码"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/search_box_back"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_gold"
            android:text="连接并保存"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bg_primary"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/cancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_btn_ghost"
            android:text="取消"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="14sp"
        android:textColor="@color/gold_primary" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="焦点样式"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface"
            android:paddingBottom="12dp" />

        <!-- 隐藏焦点指示 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/focusHiddenBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusUp="@id/radiusBox"
            android:nextFocusDown="@id/borderWidthBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/focusHiddenSwitch">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="隐藏焦点指示"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="隐藏后无边框/缩放，用 OK 键操作" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/focusHiddenSwitch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 边框宽度 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/borderWidthBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/focusHiddenBox"
            android:nextFocusDown="@id/borderColorBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/borderWidthValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="边框宽度"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="0-8 dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/borderWidthValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="3dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 边框颜色 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/borderColorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/borderWidthBox"
            android:nextFocusDown="@id/scaleBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/borderColorValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="边框颜色"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="白 / 金 / 蓝 / 红" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/borderColorValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="白色"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 缩放倍率 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scaleBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginTop="8dp"
            android:nextFocusUp="@id/borderColorBox"
            android:nextFocusDown="@id/radiusBox"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/scaleValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="缩放倍率"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="0-30%，0=不变" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/scaleValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="5%"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 圆角半径 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/radiusBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusDown="@id/focusHiddenBox"
            android:layout_marginTop="8dp"
            android:background="@drawable/video_selector">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/radiusValue">
                <TextView android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" android:text="圆角半径"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:textSize="14sp" android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="0-30 dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/radiusValue" android:textSize="16sp"
                android:textColor="@color/md_theme_onSurface" android:text="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
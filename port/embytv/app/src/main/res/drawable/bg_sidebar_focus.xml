<?xml version="1.0" encoding="utf-8"?>
<!-- 星光影院：聚焦胶囊=金色渐变+外发光（双层辉光） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层辉光（金色半透明宽边） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#55E8B64C" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- 中层（过渡） -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#33E8B64C" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- 内层：金色渐变胶囊 -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFF2CE7F"
                android:endColor="#FFD9A735"
                android:angle="0" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
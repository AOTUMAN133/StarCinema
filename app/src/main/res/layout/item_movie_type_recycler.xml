<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/box"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="24dp">

        <!-- 金色竖条装饰 -->
        <View
            android:layout_width="5dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:background="@color/star_gold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/typeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 定稿图：行标题右侧"更多 >" -->
        <TextView
            android:id="@+id/moreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:focusable="false"
            android:text="更多 >"
            android:textColor="@color/star_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/typeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_badge_capsule"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/apple_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/videoList"
        android:orientation="horizontal"
        android:nextFocusUp="@id/typeText"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:dpadRecyclerViewItemSpacing="10dp" />

</LinearLayout>
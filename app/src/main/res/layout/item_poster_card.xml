<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="0dp"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical"
    android:clipChildren="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/imageBox"
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:clipToOutline="true"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/apple_card"
        app:cardElevation="0dp"
        app:strokeColor="#00FFFFFF"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/posterImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- 星光影院：底部黑色渐变遮罩（热门推荐卡规格） -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_bottom_gradient" />

            <!-- 设计稿：海报无角标 -->

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:paddingHorizontal="2dp"
        android:textColor="@color/apple_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        android:textColor="@color/apple_text_secondary"
        android:textSize="12sp" />

    <!-- 星光影院：金色评分 ★ -->
    <TextView
        android:id="@+id/ratingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/star_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_left_gradient" />

    <!-- 星光影院：底部深黑渐变遮罩（保护底部相关推荐区） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_detail_bottom_gradient" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:focusable="false">

            <!-- 标题区（顶部焦点锚点：始终可见可聚焦，向上焦点停留在此不消失） -->
            <LinearLayout
                android:id="@+id/name_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:focusable="true"
                android:nextFocusUp="@id/name_box"
                android:nextFocusDown="@id/overviewText"
                android:paddingHorizontal="14dp">
                <TextView
                    android:id="@+id/itemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
                <!-- 星光影院：标题下金色装饰线 -->
                <View
                    android:layout_width="64dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/star_gold" />
                <!-- Logo 图（备用） -->
                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:adjustViewBounds="true"
                    android:maxWidth="200dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 信息行：评分/年份/时长/分辨率/类型 -->
            <LinearLayout
                android:id="@+id/infoRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="6dp">
                <TextView
                    android:id="@+id/ratingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/star_gold"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/officialRatingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/official_rating_back"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/yearText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/star_text_secondary"
                    android:textSize="22sp"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/metaSep1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="@color/star_text_secondary"
                    android:textSize="22sp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/runtimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/star_text_secondary"
                    android:textSize="22sp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/metaSep2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="@color/star_text_secondary"
                    android:textSize="22sp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/resolutionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/genreRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical" />
                <TextView
                    android:id="@+id/seasonNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 简介（3行，可聚焦，focus 下到播放按钮） -->
            <TextView
                android:id="@+id/overviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:focusable="true"
                android:nextFocusDown="@+id/actionBtnContainer"
                android:visibility="gone" />

            <!-- 操作按钮行（HorizontalScrollView） -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:focusable="false"
                android:paddingHorizontal="14dp">
                <LinearLayout
                    android:id="@+id/actionBtnContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 外部链接行（IMDB / TMDb / 官网 等，动态填充按钮） -->
            <LinearLayout
                android:id="@+id/externalLinksRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:focusable="false"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:visibility="gone" />

            <!-- 主演（星光影院：金色标题+金竖条） -->
            <LinearLayout
                android:id="@+id/castSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:paddingBottom="8dp">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/star_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/star_gold"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:text="主演" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/castRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <!-- 预告片 -->
            <LinearLayout
                android:id="@+id/trailerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:nextFocusDown="@+id/episodesSection"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="预告片"
                    android:padding="20dp"
                    android:paddingBottom="8dp" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/trailerRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <!-- 剧集 -->
            <LinearLayout
                android:id="@+id/episodesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:nextFocusDown="@+id/recommendSection"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:paddingBottom="8dp">

                    <!-- 星光影院：金色竖条 -->
                    <View
                        android:layout_width="5dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/star_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:text="分季" />
                </LinearLayout>
                <!-- 季选择：胶囊标签行，聚焦切换对应季剧集 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/seasonRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:paddingBottom="8dp"
                    android:paddingTop="16dp">

                    <!-- 星光影院：金色竖条 -->
                    <View
                        android:layout_width="5dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/star_gold" />

                    <TextView
                        android:id="@+id/episodeRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:text="剧集" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodeRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <!-- 推荐 -->
            <LinearLayout
                android:id="@+id/recommendSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:paddingBottom="8dp">

                    <!-- 星光影院：金色竖条 -->
                    <View
                        android:layout_width="5dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/star_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/star_gold"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:text="相关推荐" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>


            <!-- 媒体信息 -->
            <LinearLayout
                android:id="@+id/mediaInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@drawable/btn_select_focused_circle_no"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="64dp">

        <!-- 服务器设置（核心入口，置顶） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/serverSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/serverSet"
            android:nextFocusRight="@id/serverSet"
            android:nextFocusUp="@id/aboutSet"
            android:nextFocusDown="@+id/alistSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/material_video_library"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_server"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务器"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emby 服务器列表 / 添加 / 切换"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 网盘（AList，从 AfuseKtV 移植） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alistSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/alistSet"
            android:nextFocusRight="@id/alistSet"
            android:nextFocusUp="@+id/serverSet"
            android:nextFocusDown="@+id/webdavSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_alist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cloud_sync_24px"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_alist"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AList 网盘"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AList 服务器 / 目录浏览 / 在线播放"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- WebDAV 网盘 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/webdavSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/webdavSet"
            android:nextFocusRight="@id/webdavSet"
            android:nextFocusUp="@+id/alistSet"
            android:nextFocusDown="@+id/smbSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_webdav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cloud_sync_24px"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_webdav"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WebDAV"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WebDAV 服务器 / 目录浏览 / 在线播放"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SMB 网络播放 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/smbSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/smbSet"
            android:nextFocusRight="@id/smbSet"
            android:nextFocusUp="@+id/webdavSet"
            android:nextFocusDown="@+id/accountSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_smb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/link_24px"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_smb"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMB 网络播放"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMB 共享 / 目录浏览 / 在线播放"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 账户 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/accountSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/accountSet"
            android:nextFocusRight="@id/accountSet"
            android:nextFocusUp="@+id/smbSet"
            android:nextFocusDown="@+id/generalSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/account"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_account"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账户"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用户信息 / 退出登录"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 通用设置 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/generalSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/generalSet"
            android:nextFocusRight="@id/generalSet"
            android:nextFocusUp="@+id/accountSet"
            android:nextFocusDown="@+id/playControl"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_general"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/setting"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_general"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通用"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="焦点样式 / 首页 / 海报 / 缓存"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 播放控制 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/playControl"
            android:nextFocusRight="@id/playControl"
            android:nextFocusUp="@+id/generalSet"
            android:nextFocusDown="@+id/aboutSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_playback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_action_play_white"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_playback"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放控制"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放器 / 解码 / 字幕 / 倍速 / 跳过片头"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 关于 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/aboutSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:focusable="true"
            android:nextFocusLeft="@id/aboutSet"
            android:nextFocusRight="@id/aboutSet"
            android:nextFocusUp="@id/playControl"
            android:nextFocusDown="@id/serverSet"
            android:background="@drawable/video_selector">

            <ImageView
                android:id="@+id/icon_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/about"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_theme_onSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_about"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="版本 / 更新 / 开源协议"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<!-- 星光影院桌面图标前景：立体金色五角星 + 双月牙金环 + 右上四角闪光星（设计文档 v1.0 界面01） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 右小月牙（金环元素） -->
    <path
        android:fillColor="#F5C542"
        android:pathData="M70.0,84.0 A16,16 0 1,1 84.0,70.0 A13,13 0 1,0 70.0,84.0 Z" />

    <!-- 左大月牙（金环元素） -->
    <path
        android:fillColor="#E8B64C"
        android:pathData="M66.0,16.0 A22,22 0 1,1 60.0,50.0 A18.5,18.5 0 1,0 66.0,16.0 Z" />

    <!-- 右上四角闪光星 -->
    <path
        android:fillColor="#FFE082"
        android:pathData="M88.0,9.0 L90.0,15.0 L96.0,18.0 L90.0,21.0 L88.0,27.0 L86.0,21.0 L80.0,18.0 L86.0,15.0 Z" />

    <!-- 立体金色五角星（渐变 #FFE082→#F5C542→#D4A017） -->
    <path
        android:pathData="M46.0,24.0 L51.9,41.9 L70.7,42.0 L55.5,53.1 L61.3,71.0 L46.0,60.0 L30.7,71.0 L36.5,53.1 L21.3,42.0 L40.1,41.9 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#FFE082"
                android:centerColor="#F5C542"
                android:endColor="#D4A017"
                android:startX="21.3" android:startY="24.0"
                android:endX="70.7" android:endY="71.0"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>